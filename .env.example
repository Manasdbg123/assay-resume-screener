# Copy to .env and fill in. .env is gitignored - never commit a real key.

# --- Which provider powers the AI engine: "gemini" or "claude" ---
# Both send the identical rubric and return the identical schema.
LLM_PROVIDER=gemini

# --- Gemini (get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Free-tier quota is per-model and small (20 requests/day on gemini-3.5-flash).
# Switch models for a fresh budget: gemini-2.5-flash, gemini-3.6-flash,
# gemini-3.7-flash. The pro models are usually quota-blocked without billing.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2

# --- Claude (only needed when LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=8000
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=3

# --- Behaviour ---
LLM_ENABLED=true
FALLBACK_TO_BASELINE=true     # serve keyword scores when Claude is unreachable
MAX_UPLOAD_BYTES=16777216
MAX_RESUME_CHARS=60000
MAX_JD_CHARS=30000

# --- Flask ---
SECRET_KEY=change-me-in-production

# --- Observability ---
LOG_LEVEL=INFO
JSON_LOGS=true                # false gives human-readable logs in development
SERVICE_NAME=resume-screener
APP_ENV=development
# Also write JSON logs to a rotating file. Useful when running without Docker,
# and the path Filebeat harvests outside a container. Empty = stdout only.
LOG_FILE=
